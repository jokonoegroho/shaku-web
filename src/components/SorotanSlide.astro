---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRupiah } from '../konfigurasi';
import FotoBelumTersedia from './FotoBelumTersedia.astro';

interface Props {
  produk: CollectionEntry<'produk'>[];
}

const { produk } = Astro.props;
---

<section aria-label="Sorotan katalog" aria-roledescription="karusel" data-slideshow>
  <div class="jalur" data-jalur id="jalur-sorotan">
    {
      produk.map((p, i) => (
        <a href={`/katalog/${p.id}/`} class="slide" data-slide>
          <div class="aspect-4/5 bg-latar-2">
            {p.data.foto[0] ? <Image
              src={p.data.foto[0]}
              alt={`Press-on nail ${p.data.nama}`}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 639px) 76vw, (max-width: 1023px) 45vw, 360px"
              loading={i < 3 ? 'eager' : 'lazy'}
              class="h-full w-full object-contain"
            /> : <FotoBelumTersedia />}
          </div>
          <div class="pt-3">
            <p class="text-sm font-medium">{p.data.nama}</p>
            <p class="mt-1 text-xs text-teks-redup">
              {formatRupiah(p.data.harga)}
              {!p.data.tersedia && <span class="ml-2">· Terjual</span>}
            </p>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3" data-kendali hidden>
    <button type="button" class="min-h-11 text-xs text-teks-redup underline underline-offset-4" data-otomatis aria-controls="jalur-sorotan">
      Jeda otomatis
    </button>
    <div class="flex gap-2">
      <button type="button" class="panah" data-sebelum aria-label="Produk sebelumnya" aria-controls="jalur-sorotan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
      </button>
      <button type="button" class="panah" data-berikut aria-label="Produk berikutnya" aria-controls="jalur-sorotan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .jalur {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 5px;
    margin: -5px;
  }
  .jalur::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 80%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-margin-inline: 5px;
  }
  .panah {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-garis);
    border-radius: 4px;
    cursor: pointer;
  }
  .panah:hover {
    border-color: var(--color-aksen);
  }
  [hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .jalur { gap: 24px; }
    .slide { flex-basis: calc((100% - 24px) / 2); }
  }
  @media (min-width: 1024px) {
    .slide { flex-basis: calc((100% - 48px) / 3); }
  }
</style>

<script>
  const wadah = document.querySelector<HTMLElement>('[data-slideshow]');
  const jalur = wadah?.querySelector<HTMLElement>('[data-jalur]');
  const kendali = wadah?.querySelector<HTMLElement>('[data-kendali]');
  const otomatis = wadah?.querySelector<HTMLButtonElement>('[data-otomatis]');
  const sebelum = wadah?.querySelector<HTMLButtonElement>('[data-sebelum]');
  const berikut = wadah?.querySelector<HTMLButtonElement>('[data-berikut]');
  const slide = jalur ? [...jalur.querySelectorAll<HTMLElement>('[data-slide]')] : [];

  if (wadah && jalur && kendali && otomatis && sebelum && berikut && slide.length > 1) {
    const preferensiGerak = matchMedia('(prefers-reduced-motion: reduce)');
    let berjalan = !preferensiGerak.matches;

    const hentikan = () => {
      berjalan = false;
      otomatis.textContent = 'Putar otomatis';
    };

    const geser = (arah: number) => {
      // Lebar kartu berubah mengikuti layar, bukan selebar jalur seperti banner.
      const langkah = slide[1].getBoundingClientRect().left - slide[0].getBoundingClientRect().left;
      const batas = jalur.scrollWidth - jalur.clientWidth;
      let tujuan = jalur.scrollLeft + langkah * arah;
      if (arah > 0 && jalur.scrollLeft >= batas - 2) tujuan = 0;
      if (arah < 0 && jalur.scrollLeft <= 2) tujuan = batas;
      jalur.scrollTo({
        left: Math.max(0, Math.min(tujuan, batas)),
        behavior: preferensiGerak.matches ? 'instant' : 'smooth',
      });
    };

    const sesuaikan = () => {
      kendali.hidden = jalur.scrollWidth <= jalur.clientWidth + 2;
    };
    new ResizeObserver(sesuaikan).observe(jalur);
    sesuaikan();
    if (!berjalan) hentikan();

    sebelum.addEventListener('click', () => { hentikan(); geser(-1); });
    berikut.addEventListener('click', () => { hentikan(); geser(1); });
    otomatis.addEventListener('click', () => {
      berjalan = !berjalan;
      otomatis.textContent = berjalan ? 'Jeda otomatis' : 'Putar otomatis';
    });

    ['pointerdown', 'touchstart', 'wheel', 'keydown', 'focusin'].forEach((nama) =>
      jalur.addEventListener(nama, hentikan, { passive: true }),
    );
    preferensiGerak.addEventListener('change', hentikan);

    window.setInterval(() => {
      if (!berjalan || document.hidden || kendali.hidden || wadah.matches(':hover') || wadah.contains(document.activeElement)) return;
      geser(1);
    }, 4500);
  }
</script>
