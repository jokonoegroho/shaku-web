---
import { Image } from 'astro:assets';
import logo from '../assets/logo-shaku.png';
import { SITUS, tautanWhatsApp } from '../konfigurasi';

const tahun = new Date().getFullYear();
const waUmum = tautanWhatsApp(`Halo ${SITUS.nama}, saya mau tanya soal produk.`);
---

<footer class="border-t border-garis bg-latar-2">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-2 sm:px-8 sm:py-12 lg:grid-cols-4">
    <div class="sm:col-span-2">
      <div class="flex items-center gap-3">
        <Image
          src={logo}
          alt={`Logo ${SITUS.nama}`}
          widths={[96, 192]}
          sizes="48px"
          loading="lazy"
          class="h-12 w-12 rounded-full ring-1 ring-garis"
        />
        <div>
          <p class="judul text-2xl">{SITUS.nama}</p>
          <p class="text-xs text-teks-redup">{SITUS.subMerek}</p>
        </div>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-teks-redup">
        {SITUS.deskripsi}
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold text-teks">Jelajahi</p>
      <ul class="mt-4 space-y-2 text-sm text-teks-redup">
        <li><a class="hover:text-aksen" href="/katalog/">Katalog</a></li>
        <li><a class="hover:text-aksen" href="/cara-pesan/">Cara Pesan</a></li>
        <li><a class="hover:text-aksen" href="/tentang/">Tentang</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold text-teks">Hubungi</p>
      <ul class="mt-4 space-y-2 text-sm text-teks-redup">
        <li><a class="hover:text-aksen" href={waUmum} rel="noopener">WhatsApp</a></li>
        {
          SITUS.instagram && (
            <li>
              <a class="hover:text-aksen" href={`https://instagram.com/${SITUS.instagram}`} rel="noopener">
                Instagram
              </a>
            </li>
          )
        }
        {
          SITUS.tiktok && (
            <li>
              <a class="hover:text-aksen" href={`https://tiktok.com/@${SITUS.tiktok}`} rel="noopener">
                TikTok
              </a>
            </li>
          )
        }
        {
          SITUS.email && (
            <li>
              <a class="hover:text-aksen" href={`mailto:${SITUS.email}`}>{SITUS.email}</a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-garis/60 px-4 py-6">
    <p class="mx-auto max-w-6xl text-xs text-teks-redup">
      © {tahun} {SITUS.nama}. Seluruh hak cipta dilindungi.
    </p>
  </div>
</footer>
