---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRupiah } from '../konfigurasi';

interface Props {
  produk: CollectionEntry<'produk'>;
  /** Gambar pertama di layar dimuat langsung, sisanya malas-muat. */
  prioritas?: boolean;
}

const { produk, prioritas = false } = Astro.props;
const d = produk.data;
const diskon = d.hargaCoret && d.hargaCoret > d.harga
  ? Math.round(((d.hargaCoret - d.harga) / d.hargaCoret) * 100)
  : 0;
---

<article
  class="group relative overflow-hidden rounded-2xl border border-garis bg-latar-2 transition hover:border-aksen/60"
  data-bentuk={d.bentuk}
  data-panjang={d.panjang}
  data-warna={d.warna.join(' ')}
  data-tersedia={String(d.tersedia)}
>
  <a href={`/katalog/${produk.id}/`} class="block">
    <div class="relative aspect-4/5 overflow-hidden bg-latar-3">
      <Image
        src={d.foto[0]}
        alt={`Press-on nail ${d.nama}`}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 300px"
        loading={prioritas ? 'eager' : 'lazy'}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />

      {
        !d.tersedia && (
          <div class="absolute inset-0 flex items-center justify-center bg-latar/70">
            <span class="rounded-full border border-garis px-3 py-1 text-xs font-semibold tracking-wide text-teks-redup">
              TERJUAL
            </span>
          </div>
        )
      }

      {
        diskon > 0 && d.tersedia && (
          <span class="absolute top-3 left-3 rounded-full bg-aksen px-2.5 py-1 text-xs font-bold text-di-aksen">
            -{diskon}%
          </span>
        )
      }
    </div>

    <div class="p-4">
      <h3 class="judul text-xl text-teks">{d.nama}</h3>
      <p class="mt-1 text-xs text-teks-redup capitalize">
        {d.bentuk} · {d.panjang} · {d.jumlahKuku} pcs
      </p>
      <p class="mt-3 flex items-baseline gap-2">
        <span class="text-base font-semibold text-teks">{formatRupiah(d.harga)}</span>
        {
          diskon > 0 && (
            <span class="text-xs text-teks-redup line-through">
              {formatRupiah(d.hargaCoret!)}
            </span>
          )
        }
      </p>
    </div>
  </a>
</article>
