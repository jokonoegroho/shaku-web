---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatRupiah } from '../konfigurasi';

interface Props {
  produk: CollectionEntry<'produk'>;
  /** Gambar pertama di layar dimuat langsung, sisanya malas-muat. */
  prioritas?: boolean;
}

const { produk, prioritas = false } = Astro.props;
const d = produk.data;
const diskon = d.hargaCoret && d.hargaCoret > d.harga
  ? Math.round(((d.hargaCoret - d.harga) / d.hargaCoret) * 100)
  : 0;
---

<article
  class="relative min-w-0 bg-latar"
  data-bentuk={d.bentuk}
  data-panjang={d.panjang}
  data-warna={d.warna.join(' ')}
  data-tersedia={String(d.tersedia)}
  data-pencarian={[d.nama, d.bentuk, d.panjang, ...d.warna].join(' ')}
>
  <a href={`/katalog/${produk.id}/`} class="block">
    <div class="relative aspect-4/5 overflow-hidden bg-latar-2">
      <Image
        src={d.foto[0]}
        alt={`Press-on nail ${d.nama}`}
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 300px"
        loading={prioritas ? 'eager' : 'lazy'}
        class="h-full w-full object-contain"
      />

      {
        !d.tersedia && (
          <div class="absolute bottom-3 left-3">
            <span class="bg-latar px-3 py-1.5 text-[10px] font-medium tracking-wide text-teks-redup">
              TERJUAL
            </span>
          </div>
        )
      }

      {
        diskon > 0 && d.tersedia && (
          <span class="absolute top-3 left-3 bg-aksen px-2.5 py-1 text-xs font-medium text-di-aksen">
            -{diskon}%
          </span>
        )
      }
    </div>

    <div class="pt-3 pb-4">
      <h3 class="text-sm font-medium text-teks">{d.nama}</h3>
      <p class="mt-1 text-xs text-teks-redup capitalize">
        {d.bentuk} · {d.panjang} · {d.jumlahKuku} pcs
      </p>
      <p class="mt-2 flex flex-wrap items-baseline gap-2">
        <span class="text-sm text-teks">{formatRupiah(d.harga)}</span>
        {
          diskon > 0 && (
            <span class="text-xs text-teks-redup line-through">
              {formatRupiah(d.hargaCoret!)}
            </span>
          )
        }
      </p>
    </div>
  </a>
</article>
