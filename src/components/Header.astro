---
import '@fontsource/poppins/200.css';
import { TAUTAN_UTAMA } from '../konfigurasi';
import IdentitasMerek from './IdentitasMerek.astro';
import MenuSeluler from './MenuSeluler.astro';

const jalurAktif = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 bg-black"
>
  <p class="pengumuman text-center text-white">
    GRATIS ONGKIR UNTUK SELURUH PULAU JAWA
  </p>
  {jalurAktif !== '/' && (
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 sm:h-16 sm:px-8">
    <IdentitasMerek />

    <nav class="hidden gap-8 md:flex" aria-label="Navigasi utama">
      {
        TAUTAN_UTAMA.map((t) => (
          <a
            href={t.href}
            class:list={[
              'text-sm font-medium text-[#FFF8F0] underline-offset-4 transition-colors hover:text-white',
              jalurAktif === t.href ? 'underline' : '',
            ]}
            aria-current={jalurAktif === t.href ? 'page' : undefined}
          >
            {t.label}
          </a>
        ))
      }
    </nav>

    <MenuSeluler />
  </div>
  )}

</header>

<style>
  .pengumuman {
    padding: 9.1px;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 200;
    line-height: 1.2;
    letter-spacing: normal;
  }
  header {
    box-shadow: 0 4px 14px rgb(0 0 0 / 22%);
  }
  header :global(.menu-seluler > button) {
    color: #fff8f0;
  }
</style>
