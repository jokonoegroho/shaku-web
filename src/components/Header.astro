---
import { Image } from 'astro:assets';
import logo from '../assets/logo-shaku.png';
import wordmark from '../assets/wordmark-shaku.png';
import { SITUS, TAUTAN_UTAMA } from '../konfigurasi';
import MenuSeluler from './MenuSeluler.astro';

const jalurAktif = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-garis bg-latar"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 sm:h-16 sm:px-8">
    <a href="/" class="-ml-1 flex items-center gap-2">
      <Image
        src={logo}
        alt={`Logo ${SITUS.nama}`}
        widths={[80, 160]}
        sizes="40px"
        loading="eager"
        class="h-10 w-10 rounded-full ring-1 ring-garis"
      />
      <Image
        src={wordmark}
        alt={SITUS.nama}
        widths={[75, 150, 225]}
        sizes="75px"
        loading="eager"
        class="h-auto w-[75px]"
      />
    </a>

    <nav class="hidden gap-8 md:flex" aria-label="Navigasi utama">
      {
        TAUTAN_UTAMA.map((t) => (
          <a
            href={t.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-teks',
              jalurAktif === t.href ? 'text-aksen' : 'text-teks-redup',
            ]}
            aria-current={jalurAktif === t.href ? 'page' : undefined}
          >
            {t.label}
          </a>
        ))
      }
    </nav>

    {jalurAktif !== '/' && <MenuSeluler />}
  </div>

</header>
