---
import Layout from '../layouts/Layout.astro';
import { SITUS, isiTemplat, tautanWhatsApp } from '../konfigurasi';
import { TENTANG } from '../konten-halaman';

const teks = (nilai: string) => isiTemplat(nilai, { nama: SITUS.nama });
const wa = tautanWhatsApp(teks(TENTANG.ajakan.pesanWhatsApp));
---

<Layout
  judul={teks(TENTANG.meta.judul)}
  deskripsi={teks(TENTANG.meta.deskripsi)}
>
  <section class="mx-auto max-w-3xl px-5 py-10 sm:px-8 sm:py-14">
    <h1 class="judul text-3xl sm:text-5xl">{teks(TENTANG.judul)}</h1>

    <div class="konten-kaya mt-8 text-sm leading-relaxed text-teks-redup">
      {TENTANG.paragraf.map((paragraf) => <p>{teks(paragraf)}</p>)}
    </div>

    <div class="mt-12 border-y border-garis py-6">
      <h2 class="judul text-2xl">{teks(TENTANG.ajakan.judul)}</h2>
      <p class="mt-2 text-sm text-teks-redup">
        {teks(TENTANG.ajakan.deskripsi)}
      </p>
      <a
        href={wa}
        rel="noopener"
        class="tombol mt-5 bg-aksen px-7 py-3 text-di-aksen transition-colors hover:bg-aksen-terang"
      >
        {teks(TENTANG.ajakan.tombol)}
      </a>
    </div>
  </section>
</Layout>
