---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gambarKepala from '../assets/header-shaku.png';
import Layout from '../layouts/Layout.astro';
import KartuProduk from '../components/KartuProduk.astro';
import SorotanSlide from '../components/SorotanSlide.astro';
import { SITUS, tautanWhatsApp } from '../konfigurasi';

const semua = await getCollection('produk');
const unggulan = semua
  .filter((p) => p.data.unggulan)
  .sort((a, b) => a.data.urutan - b.data.urutan)
  .slice(0, 4);

/* Slide sorotan: yang masih tersedia didahulukan supaya pengunjung baru
   melihat desain yang benar-benar bisa dibeli. */
const sorotan = [...semua]
  .sort((a, b) => {
    if (a.data.tersedia !== b.data.tersedia) return a.data.tersedia ? -1 : 1;
    return a.data.urutan - b.data.urutan;
  })
  .slice(0, 5);

const waUmum = tautanWhatsApp(`Halo ${SITUS.nama}, saya mau tanya soal produk.`);

const keunggulan = [
  {
    judul: 'Pasang sendiri 10 menit',
    isi: 'Tidak perlu janji temu, tidak perlu ke salon. Semua alat sudah termasuk dalam satu paket.',
  },
  {
    judul: 'Bisa dipakai ulang',
    isi: 'Lepas dengan benar, bersihkan sisa lem, lalu simpan. Satu set bisa dipakai berkali-kali.',
  },
  {
    judul: 'Sepuluh ukuran per set',
    isi: 'Isi 24 keping dengan sepuluh ukuran berbeda, jadi lebih mudah menemukan yang pas.',
  },
];
---

<Layout judul={SITUS.nama}>
  <!-- Sorotan katalog: langsung menampilkan desain, karena kelangkaan satu
       desain satu set adalah nilai jual utama yang harus terlihat lebih dulu. -->
  <SorotanSlide produk={sorotan} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-garis">
    <div
      class="pointer-events-none absolute -top-40 -right-24 h-96 w-96 rounded-full bg-aksen/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-3xl px-4 py-6 sm:py-9">
      <!-- Ukuran ikut lebar layar dengan clamp supaya judul selalu muat satu baris. -->
      <h1
        class="hiasan text-center text-[clamp(1.15rem,5.4vw,3rem)] whitespace-nowrap"
      >
        Kuku cantik <span class="text-aksen">tanpa ke salon.</span>
      </h1>

      <div class="mt-2 text-center text-base leading-relaxed text-teks-redup">
        <p>
          <span class="block text-xl font-semibold text-aksen sm:text-2xl">
            Sha.ku one of one
          </span>
          <span class="mt-1 block text-xs tracking-[0.2em] text-teks uppercase">
            A design made only for you
          </span>
        </p>
      </div>

      <!-- Dua tombol dibuat sama lebar dengan grid supaya bobotnya seimbang,
           bukan mengikuti panjang tulisan masing-masing. -->
      <div class="mt-5 grid grid-cols-2 gap-3 sm:mx-auto sm:max-w-md">
        <a
          href="/katalog/"
          class="rounded-full bg-aksen px-4 py-3 text-center text-sm font-semibold text-di-aksen transition hover:bg-aksen-terang"
        >
          Lihat katalog
        </a>
        <a
          href={waUmum}
          rel="noopener"
          class="rounded-full border border-garis px-4 py-3 text-center text-sm font-semibold text-teks transition hover:border-aksen hover:text-aksen"
        >
          Tanya via WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Produk unggulan -->
  <section class="mx-auto max-w-6xl px-4 pt-4 pb-14">
    <!-- Judul disembunyikan secara visual tapi tetap ada untuk pembaca layar
         dan mesin pencari, supaya bagian ini tidak kehilangan penanda. -->
    <h2 class="sr-only">Paling dicari</h2>
    <div class="flex justify-end">
      <a href="/katalog/" class="text-sm font-medium text-aksen hover:underline">
        Lihat semua →
      </a>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {unggulan.map((p, i) => <KartuProduk produk={p} prioritas={i < 2} />)}
    </div>
  </section>

  <!-- Gambar merek dipindah ke bawah katalog: identitas sudah dibawa header,
       jadi tempatnya di sini sebagai jeda, bukan penghalang sebelum produk. -->
  <Image
    src={gambarKepala}
    alt={`${SITUS.nama} — ${SITUS.subMerek}`}
    widths={[640, 960, 1280, 2000]}
    sizes="100vw"
    loading="lazy"
    class="max-h-[200px] w-full object-cover object-center sm:max-h-[280px] lg:max-h-[340px]"
  />

  <!-- Keunggulan -->
  <section class="border-y border-garis bg-latar-2">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:grid-cols-3">
      {
        keunggulan.map((k) => (
          <div>
            <h3 class="judul text-2xl text-teks">{k.judul}</h3>
            <p class="mt-3 text-sm leading-relaxed text-teks-redup">{k.isi}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Ajakan -->
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h2 class="judul text-3xl sm:text-4xl">Bingung pilih yang mana?</h2>
    <p class="mt-4 text-sm leading-relaxed text-teks-redup">
      Kirim foto tanganmu lewat WhatsApp, nanti dibantu pilihkan bentuk dan ukuran yang paling pas.
    </p>
    <a
      href={waUmum}
      rel="noopener"
      class="mt-8 inline-block rounded-full bg-aksen px-8 py-3 text-sm font-semibold text-di-aksen transition hover:bg-aksen-terang"
    >
      Chat sekarang
    </a>
  </section>
</Layout>
