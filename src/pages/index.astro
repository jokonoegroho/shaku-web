---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/logo-shaku.png';
import Layout from '../layouts/Layout.astro';
import KartuProduk from '../components/KartuProduk.astro';
import { SITUS, tautanWhatsApp } from '../konfigurasi';

const semua = await getCollection('produk');
const unggulan = semua
  .filter((p) => p.data.unggulan)
  .sort((a, b) => a.data.urutan - b.data.urutan)
  .slice(0, 4);

const waUmum = tautanWhatsApp(`Halo ${SITUS.nama}, saya mau tanya soal produk.`);

const keunggulan = [
  {
    judul: 'Pasang sendiri 10 menit',
    isi: 'Tidak perlu janji temu, tidak perlu ke salon. Semua alat sudah termasuk dalam satu paket.',
  },
  {
    judul: 'Bisa dipakai ulang',
    isi: 'Lepas dengan benar, bersihkan sisa lem, lalu simpan. Satu set bisa dipakai berkali-kali.',
  },
  {
    judul: 'Sepuluh ukuran per set',
    isi: 'Isi 24 keping dengan sepuluh ukuran berbeda, jadi lebih mudah menemukan yang pas.',
  },
];
---

<Layout judul={SITUS.nama}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-garis">
    <div
      class="pointer-events-none absolute -top-40 -right-24 h-96 w-96 rounded-full bg-aksen/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:py-28 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="text-xs font-semibold tracking-[0.3em] text-aksen uppercase">
          Press-on nail · {SITUS.subMerek}
        </p>
        <h1 class="judul mt-4 text-4xl sm:text-6xl">
          Kuku cantik<br />
          <span class="text-aksen">tanpa ke salon.</span>
        </h1>
        <div class="mt-6 max-w-lg space-y-2 text-base leading-snug text-teks-redup">
          <p>Behind every little set of nails, there's a little bit of love. ♡</p>
          <p>
            <strong class="font-semibold text-teks">sha.ku</strong> hadir untuk memberikan
            pengalaman memakai press-on nails yang cantik, praktis, cepat dan tetap terasa
            personal.
          </p>
          <p class="my-4 border-l-2 border-aksen pl-4">
            <span class="judul block text-xl font-semibold text-aksen sm:text-2xl">
              Sha.ku one of one
            </span>
            <span class="mt-1 block text-xs tracking-[0.2em] text-teks uppercase">
              A design made only for you
            </span>
            <span class="mt-2 block text-base text-teks-redup normal-case tracking-normal">
              Satu desain dibuat satu kali. Setelah terjual, desain itu tidak dibuat ulang — jadi
              yang kamu pakai tidak dipakai orang lain.
            </span>
          </p>
          <p>
            Setiap desain dibuat hanya untukmu dengan perhatian pada detail, karena kami percaya
            kamu deserve something pretty. 🍷
          </p>
          <p class="font-semibold text-teks">small details. pretty moments. sha.ku.</p>
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/katalog/"
            class="rounded-full bg-aksen px-7 py-3 text-sm font-semibold text-di-aksen transition hover:bg-aksen-terang"
          >
            Lihat katalog
          </a>
          <a
            href={waUmum}
            rel="noopener"
            class="rounded-full border border-garis px-7 py-3 text-sm font-semibold text-teks transition hover:border-aksen hover:text-aksen"
          >
            Tanya via WhatsApp
          </a>
        </div>
      </div>

      <div class="relative order-first lg:order-none">
        <div
          class="pointer-events-none absolute inset-0 -m-6 rounded-full bg-aksen/10 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <Image
          src={logo}
          alt={`Logo ${SITUS.nama} — ${SITUS.subMerek}`}
          widths={[320, 480, 640]}
          sizes="(max-width: 1024px) 60vw, 420px"
          loading="eager"
          class="relative mx-auto w-2/3 max-w-md rounded-full shadow-xl shadow-aksen/20 lg:w-full"
        />
      </div>
    </div>
  </section>

  <!-- Produk unggulan -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="flex items-end justify-between gap-4">
      <h2 class="judul text-3xl sm:text-4xl">Paling dicari</h2>
      <a href="/katalog/" class="text-sm font-medium text-aksen hover:underline">
        Lihat semua →
      </a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {unggulan.map((p, i) => <KartuProduk produk={p} prioritas={i < 2} />)}
    </div>
  </section>

  <!-- Keunggulan -->
  <section class="border-y border-garis bg-latar-2">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:grid-cols-3">
      {
        keunggulan.map((k) => (
          <div>
            <h3 class="judul text-2xl text-teks">{k.judul}</h3>
            <p class="mt-3 text-sm leading-relaxed text-teks-redup">{k.isi}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Ajakan -->
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h2 class="judul text-3xl sm:text-4xl">Bingung pilih yang mana?</h2>
    <p class="mt-4 text-sm leading-relaxed text-teks-redup">
      Kirim foto tanganmu lewat WhatsApp, nanti dibantu pilihkan bentuk dan ukuran yang paling pas.
    </p>
    <a
      href={waUmum}
      rel="noopener"
      class="mt-8 inline-block rounded-full bg-aksen px-8 py-3 text-sm font-semibold text-di-aksen transition hover:bg-aksen-terang"
    >
      Chat sekarang
    </a>
  </section>
</Layout>
