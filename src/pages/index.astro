---
import { getCollection } from 'astro:content';
import BannerBeranda from '../components/BannerBeranda.astro';
import Layout from '../layouts/Layout.astro';
import KartuProduk from '../components/KartuProduk.astro';
import { SITUS, pesanUmum, tautanWhatsApp } from '../konfigurasi';
import { BERANDA } from '../konten';

const semua = await getCollection('produk');

/* Seluruh produk masuk beranda, tanpa batas jumlah, supaya desain baru yang
   ditambahkan lewat panel admin ikut tampil dengan sendirinya. Yang masih
   tersedia didahulukan agar pengunjung tidak disambut desain yang habis. */
const produkBeranda = [...semua].sort((a, b) => {
  if (a.data.tersedia !== b.data.tersedia) return a.data.tersedia ? -1 : 1;
  return a.data.urutan - b.data.urutan;
});

const waUmum = tautanWhatsApp(pesanUmum());
---

<Layout judul={SITUS.nama}>
  <section class="pembuka-beranda">
    <BannerBeranda />

    <div class="bg-[#faf7f7]">
      <div class="mx-auto max-w-3xl px-5 pt-4 pb-20 text-center sm:pt-6 sm:pb-7">
        <h1
          class="hiasan break-words text-[clamp(0.875rem,4.7vw,2.75rem)]"
        >
          {BERANDA.judul}
        </h1>

        <p class="mt-3 text-sm font-semibold tracking-[0.08em] text-aksen uppercase sm:text-lg">
          {BERANDA.jargon}
        </p>
        <p class="mt-1 text-xs font-medium text-teks sm:text-sm">
          {BERANDA.subJargon}
        </p>
      </div>
    </div>
  </section>

  <!-- Sorotan katalog: seluruh produk ikut, jadi desain baru yang ditambahkan
       lewat panel admin langsung muncul di sini tanpa mengubah kode. -->
  <section class="mx-auto max-w-6xl px-5 pt-2 pb-10 sm:px-8 sm:pb-14">
    <h2 class="sr-only">{BERANDA.judulKatalog}</h2>
    <div class="flex justify-end pb-4">
      <a href="/katalog/" class="inline-flex min-h-11 items-center text-xs font-medium text-aksen underline-offset-4 hover:underline">
        {BERANDA.tautanKatalog}
      </a>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4" data-produk-beranda>
      {produkBeranda.map((p, i) => <KartuProduk produk={p} prioritas={i < 4} />)}
    </div>
  </section>

  <!-- Keunggulan -->
  {BERANDA.tampilkanKeunggulan && BERANDA.keunggulan.length > 0 && <section class="border-y border-garis">
    <div class="mx-auto grid max-w-6xl gap-7 px-5 py-9 sm:grid-cols-3 sm:gap-10 sm:px-8 sm:py-12">
      {
        BERANDA.keunggulan.map((k) => (
          <div>
            <h3 class="text-sm font-medium text-teks">{k.judul}</h3>
            <p class="mt-2 max-w-sm text-xs leading-6 text-teks-redup">{k.isi}</p>
          </div>
        ))
      }
    </div>
  </section>}

  <!-- Ajakan -->
  {BERANDA.tampilkanAjakan && <section class="mx-auto max-w-xl px-5 py-12 text-center sm:py-16">
    <h2 class="judul text-3xl sm:text-4xl">{BERANDA.ajakanJudul}</h2>
    <p class="mt-3 text-sm leading-relaxed text-teks-redup">
      {BERANDA.ajakanIsi}
    </p>
    <a
      href={waUmum}
      rel="noopener"
      class="tombol mt-5 border border-garis px-7 py-3 text-aksen transition-colors hover:border-aksen"
    >
      {BERANDA.ajakanTombol}
    </a>
  </section>}
</Layout>

<style>
  .pembuka-beranda {
    display: grid;
    grid-template-rows: 650px auto;
  }
</style>
