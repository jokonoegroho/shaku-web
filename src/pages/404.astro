---
import Layout from '../layouts/Layout.astro';
---

<Layout judul="Halaman tidak ditemukan">
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <p class="judul text-6xl text-aksen">404</p>
    <h1 class="judul mt-4 text-3xl">Halaman tidak ditemukan</h1>
    <p class="mt-4 text-sm text-teks-redup">
      Alamat yang kamu buka tidak ada, atau desainnya sudah tidak dijual lagi.
    </p>
    <a
      href="/katalog/"
      class="tombol mt-8 bg-aksen px-7 py-3 text-di-aksen transition-colors hover:bg-aksen-terang"
    >
      Lihat katalog
    </a>
  </section>
</Layout>
