---
import Layout from '../layouts/Layout.astro';
import { SITUS, isiTemplat, tautanWhatsApp } from '../konfigurasi';
import { CARA_PESAN } from '../konten-halaman';

const teks = (nilai: string) => isiTemplat(nilai, { nama: SITUS.nama });
const wa = tautanWhatsApp(teks(CARA_PESAN.ajakan.pesanWhatsApp));
---

<Layout
  judul={teks(CARA_PESAN.meta.judul)}
  deskripsi={teks(CARA_PESAN.meta.deskripsi)}
>
  <section class="mx-auto max-w-3xl px-5 py-10 sm:px-8 sm:py-14">
    <h1 class="judul text-3xl sm:text-5xl">{teks(CARA_PESAN.judul)}</h1>
    <p class="mt-4 text-sm leading-relaxed text-teks-redup">
      {teks(CARA_PESAN.pengantar)}
    </p>

    <ol class="mt-12 space-y-8">
      {
        CARA_PESAN.langkah.map((l, i) => (
          <li class="flex gap-5">
            <span class="judul shrink-0 text-4xl text-aksen">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2 class="text-base font-semibold text-teks">{teks(l.judul)}</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-teks-redup">{teks(l.isi)}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 border-y border-garis py-6">
      <h2 class="judul text-2xl">{teks(CARA_PESAN.ajakan.judul)}</h2>
      <p class="mt-2 text-sm text-teks-redup">
        {teks(CARA_PESAN.ajakan.deskripsi)}
      </p>
      <a
        href={wa}
        rel="noopener"
        class="tombol mt-5 bg-aksen px-7 py-3 text-di-aksen transition-colors hover:bg-aksen-terang"
      >
        {teks(CARA_PESAN.ajakan.tombol)}
      </a>
    </div>

    <h2 class="judul mt-20 text-3xl">{teks(CARA_PESAN.judulFaq)}</h2>
    <div class="mt-8 divide-y divide-garis border-y border-garis">
      {
        CARA_PESAN.faq.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-sm font-medium text-teks">
              {teks(f.tanya)}
              <span class="text-aksen transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-teks-redup">{teks(f.jawab)}</p>
          </details>
        ))
      }
    </div>
  </section>
</Layout>
