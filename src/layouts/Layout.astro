---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TombolWaMengambang from '../components/TombolWaMengambang.astro';
import { SITUS } from '../konfigurasi';

interface Props {
  judul: string;
  deskripsi?: string;
  /** Gambar untuk pratinjau saat tautan dibagikan (path absolut dari root). */
  gambarOg?: string;
}

const { judul, deskripsi = SITUS.deskripsi, gambarOg = '/og.png' } = Astro.props;

const judulPenuh = judul === SITUS.nama ? SITUS.namaLengkap : `${judul} — ${SITUS.nama}`;
const urlKanonik = new URL(Astro.url.pathname, Astro.site ?? SITUS.domain).href;
const urlGambar = new URL(gambarOg, Astro.site ?? SITUS.domain).href;
---

<!doctype html>
<html lang="id" class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judulPenuh}</title>
    <meta name="description" content={deskripsi} />
    <link rel="canonical" href={urlKanonik} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITUS.nama} />
    <meta property="og:title" content={judulPenuh} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:url" content={urlKanonik} />
    <meta property="og:image" content={urlGambar} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="kepala" />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#konten"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-aksen focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-di-aksen"
    >
      Lewati ke konten
    </a>
    <Header />
    <main id="konten">
      <slot />
    </main>
    <Footer />
    <TombolWaMengambang />
  </body>
</html>
